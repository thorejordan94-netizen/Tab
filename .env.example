# Extension Foundry Environment Variables
# Copy this file to .env.local and fill in your values

# API Keys (Optional - users can also provide their own in the app)
# If set, these will be used as defaults when users don't provide their own keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=10
RATE_LIMIT_REQUESTS_PER_HOUR=50

# Optional: Enable server-side key mode
# When true, the server will use the keys above and hide API key management from users
USE_SERVER_KEYS=false
